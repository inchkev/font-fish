{
  "name": "fontfish",
  "version": "1.0.0",
  "description": "A browser tool for spatial font discovery and exploration",
  "main": "index.js",
  "scripts": {
    "build": "esbuild js/main.js --bundle --outfile=www/js/index.js --minify",
    "w": "webpack",
    "e": "node js/build.mjs",
    "clean": "rm -rf www/js",
    "generate-paths": "node fonts/generate-paths.js",
    "serve": "serve -s www/",
    "deploy": "git push origin `git subtree split --prefix www main`:gh-pages --force"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inchkev/font-fish.git"
  },
  "keywords": [
    "font"
  ],
  "author": "Kevin Chen",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/inchkev/font-fish/issues"
  },
  "homepage": "https://github.com/inchkev/font-fish#readme",
  "dependencies": {
    "esbuild": "0.17.18",
    "esbuild-plugin-wat": "^0.2.7",
    "fontfaceobserver": "^2.3.0",
    "fontkit": "^2.0.2",
    "gsap": "^3.11.5",
    "pako": "^2.1.0",
    "stats.js": "^0.17.0",
    "three": "^0.151.3",
    "troika-three-text": "^0.48.0-unicode.3"
  },
  "devDependencies": {
    "@wasm-tool/wasm-pack-plugin": "^1.7.0",
    "opentype.js": "^1.3.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
